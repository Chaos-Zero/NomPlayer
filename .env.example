# YouTube Data API v3 key, required to fetch playlist metadata.
# Get one free at: https://console.cloud.google.com/apis/library/youtube.googleapis.com
VITE_YT_API_KEY=YOUR_API_KEY_HERE
VITE_FEEDBACK_API_URL=http://bot/feedback
VITE_FEEDBACK_API_SECRET=your_feedback_secret_here

# Supabase project URL and publishable key, required for user accounts.
# Create a free project at: https://supabase.com/
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here

# Supabase CLI project ref, used by `just supabase-link`.
SUPABASE_PROJECT_REF=your_project_ref_here

# Service-role key for functions/api/vgmc-ingest.js (VGMC nomination-thread sync).
# CLOUDFLARE PAGES ENV ONLY, never prefix with VITE_, never ship this to the client
# bundle. It's the only credential that can write to a VGMC playlist; see
# supabase/migrations/20260813000000_add_vgmc_ingest_pipeline.sql.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# The bot-owned user_playlists row that functions/api/vgmc-ingest.js reconciles into
# (see the "Manual one-time setup" note in that migration). Powers the live VGMC
# standings homepage view (src/components/VgmcStandingsView.jsx), read-only client
# side, safe to expose.
VITE_VGMC_PLAYLIST_ID=your_vgmc_playlist_uuid_here

# Kill switch for the "nominations are still open" push: the GameFAQs-VGMC
# leaderboard elements on the home page (the "Live Supports" tab and the
# GameFAQs badge on every tab's rows), the home page's auto-redirect into the
# VGMC standings page, and the persistent VGMC nav toggle button (see the
# VGMC_LIVE_SUPPORTS_ENABLED constant, duplicated in both HomePage.jsx and
# App.jsx). Defaults on; set to "false" and redeploy once the nomination
# period closes and the VGMC 20 entrants are locked in - the VGMC playlist
# itself stays browsable as normal, this just stops promoting it - then flip
# it back to "true" for the next cycle.
VITE_VGMC_LIVE_SUPPORTS_ENABLED=true

# Google service account credentials for functions/api/vgmc-sheet-sync.js (the
# "Sync to Sheet" feature). The site's own Google identity writes to the VGMC
# reaction spreadsheet on behalf of whichever signed-in NomPlayer user clicks
# sync, nobody else needs their own Google account or OAuth consent, just edit
# access already granted to this service account on the sheet itself.
# CLOUDFLARE PAGES ENV ONLY, never prefix with VITE_, never ship the private key
# to the client bundle. Create both at
# https://console.cloud.google.com/iam-admin/serviceaccounts (after enabling the
# Google Sheets API on that project), download the JSON key, then share the target
# spreadsheet with GOOGLE_SHEETS_SERVICE_ACCOUNT_EMAIL as an Editor.
GOOGLE_SHEETS_SERVICE_ACCOUNT_EMAIL=your-bot@your-project.iam.gserviceaccount.com
GOOGLE_SHEETS_SERVICE_ACCOUNT_PRIVATE_KEY=your_service_account_private_key_here
