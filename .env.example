# YouTube Data API v3 key — required to fetch playlist metadata.
# Get one free at: https://console.cloud.google.com/apis/library/youtube.googleapis.com
VITE_YT_API_KEY=YOUR_API_KEY_HERE
VITE_FEEDBACK_API_URL=http://bot/feedback
VITE_FEEDBACK_API_SECRET=your_feedback_secret_here

# Supabase project URL and publishable key — required for user accounts.
# Create a free project at: https://supabase.com/
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here

# Supabase CLI project ref — used by `just supabase-link`.
SUPABASE_PROJECT_REF=your_project_ref_here

# Service-role key for functions/api/vgmc-ingest.js (VGMC nomination-thread sync).
# CLOUDFLARE PAGES ENV ONLY — never prefix with VITE_, never ship this to the client
# bundle. It's the only credential that can write to a VGMC playlist; see
# supabase/migrations/20260813000000_add_vgmc_ingest_pipeline.sql.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# The bot-owned user_playlists row that functions/api/vgmc-ingest.js reconciles into
# (see the "Manual one-time setup" note in that migration). Powers the live VGMC
# standings homepage view (src/components/VgmcStandingsView.jsx) — read-only client
# side, safe to expose.
VITE_VGMC_PLAYLIST_ID=your_vgmc_playlist_uuid_here

# Google OAuth Client ID for the "Sync to Sheet" feature (src/lib/googleSheets.js,
# src/components/VgmcSheetSyncPanel.jsx) — lets a signed-in user push their own VGMC
# ratings/comments into the community reaction spreadsheet, entirely client-side (no
# server ever sees their Google token). OAuth client IDs are meant to be public, safe
# to expose — this is NOT a client secret. Create one at
# https://console.cloud.google.com/apis/credentials (Web application type, add this
# site's origin under "Authorized JavaScript origins", no redirect URI needed) after
# enabling the Google Sheets API on that project. Leave unset to hide the feature.
VITE_GOOGLE_SHEETS_CLIENT_ID=your_google_oauth_client_id_here
